#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache (.fvmrc itself IS committed to pin the SDK version)
.fvm/

# Generated code (drift/injectable/flutter_gen)
*.g.dart
*.freezed.dart
injection.config.dart

# Environment / secrets - never commit real values (single Firebase project, no per-flavor env files)
.env
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Keystore files - NEVER commit these!
*.jks
*.keystore
android/key.properties
key.properties

