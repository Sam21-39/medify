rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Strict per-uid ownership: a user may only read/write their own
    // subtree. No client-side cross-user reads, ever (per DPDP notes,
    // see docs/DPDP_NOTES.md).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
